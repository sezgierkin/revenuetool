"use client";
import { useState, useRef, useCallback, useEffect } from "react";

const SYSTEM_PROMPT = `Sen butik ve şehir otelleri için özel olarak tasarlanmış, kârlılık odaklı bir "Yapay Zeka Gelir Yönetimi (Revenue Management) Asistanısın". Bütçe ve ciro EUR cinsindendir.

[HESAPLAMA KURALLARI]
1. Hedef Oda Havuzu = Toplam Oda × Ay Gün × Hedef Doluluk%
2. Kalan Satılabilir = Hedef Havuz − Kümülatif Satılan
3. Net ADR = Kalan Bütçe ÷ Kalan Satılabilir
4. Acenta Brüt ADR = Net ADR ÷ (1 − Komisyon%) × (1 + KDV%)
5. Direkt Brüt ADR = Net ADR × (1 + KDV%)

[STRATEJİ]
- Durum A (Acenta Brüt > Compset): Bütçe gerisindeyiz. Ekstra değer öner (transfer, ikram, esnek iptal).
- Durum B (Acenta Brüt < Compset): Avantajlıyız! Fiyatı compset'e çek, kârı maksimize et.
- Durum C (Market demand yüksek veya tatil/etkinlik varsa): MinLOS veya agresif fiyat artışı öner.

[ÇIKTI FORMATI — ZORUNLU]
📊 **Günlük Finansal Özet:** [Kalan bütçe, kalan havuz, Net ADR]
🎯 **Günün Fiyat Kararı:** [Acenta brüt ve direkt brüt fiyat — EUR]
🧠 **Stratejik Gerekçe:** [2-3 cümle piyasa + bütçe analizi]
⚡ **Aksiyon Önerisi:** [O güne özel tek operasyonel tavsiye]`;

export default function RevenueManagementTool() {
  const [constants, setConstants] = useState({
    totalRooms: "264", monthDays: "31", sellThrough: "85",
    commission: "20", vat: "12", monthlyBudget: ""
  });
  const [vars, setVars] = useState({
    realizedRevenue: "", soldRooms: "", remainingDays: "",
    compsetADR: "", compsetDetails: [], demandNotes: "", holidays: "", todayDemand: ""
  });
  const [excelData, setExcelData] = useState(null); // parsed from xlsx
  const [result, setResult] = useState(null);
  const [loading, setLoading] = useState(false);
  const [xlsxLoading, setXlsxLoading] = useState(false);
  const [exchangeRate, setExchangeRate] = useState(null);
  const [rateLoading, setRateLoading] = useState(false);
  const [rateManual, setRateManual] = useState("");
  const [error, setError] = useState(null);
  const [locked, setLocked] = useState(false);
  const [dragOver, setDragOver] = useState(false);
  const fileRef = useRef(null);

  // Calculations
  const totalRooms = parseFloat(constants.totalRooms) || 0;
  const monthDays = parseFloat(constants.monthDays) || 31;
  const sellThrough = Math.min(parseFloat(constants.sellThrough) || 85, 100) / 100;
  const commission = (parseFloat(constants.commission) || 20) / 100;
  const vat = (parseFloat(constants.vat) || 12) / 100;
  const soldRooms = parseFloat(vars.soldRooms) || 0;
  const totalMonthPool = Math.round(totalRooms * monthDays * sellThrough);
  const roomPool = vars.soldRooms !== "" ? Math.max(totalMonthPool - soldRooms, 0) : totalMonthPool;
  const occupancyPct = totalMonthPool > 0 && vars.soldRooms !== "" ? Math.round((soldRooms / totalMonthPool) * 100) : null;
  const remBudget = (parseFloat(constants.monthlyBudget) || 0) - (parseFloat(vars.realizedRevenue) || 0);
  const netADR = roomPool > 0 ? remBudget / roomPool : 0;
  const grossADR_agency = netADR > 0 ? (netADR / (1 - commission)) * (1 + vat) : 0;
  const grossADR_direct = netADR > 0 ? netADR * (1 + vat) : 0;
  const compsetEUR = parseFloat(vars.compsetADR) || 0;
  const situation = grossADR_agency === 0 ? null : grossADR_agency > compsetEUR ? "A" : "B";
  const activeRate = parseFloat(rateManual) || exchangeRate;

  // Fetch EUR/TRY rate
  const fetchRate = useCallback(async () => {
    setRateLoading(true);
    try {
      const r = await fetch("https://api.frankfurter.app/latest?from=EUR&to=TRY");
      const d = await r.json();
      if (d?.rates?.TRY) { const rate: number = Math.round(d.rates.TRY * 100) / 100; setExchangeRate(rate); }
    } catch {} finally { setRateLoading(false); }
  }, []);

  useEffect(() => { fetchRate(); }, [fetchRate]);

  // New month reset
  const handleNewMonth = () => {
    const now = new Date();
    const days = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
    setConstants(c => ({ ...c, monthDays: days.toString() }));
    setVars(v => ({ ...v, realizedRevenue: "", soldRooms: "", remainingDays: "", compsetADR: "", compsetDetails: [], demandNotes: "", holidays: "", todayDemand: "" }));
    setExcelData(null);
    setResult(null);
    setError(null);
  };

  // Parse OTA Insight Excel
  const parseExcel = useCallback(async (file) => {
    setXlsxLoading(true);
    setError(null);
    try {
      const SheetJS = await import("https://cdn.sheetjs.com/xlsx-0.20.1/package/xlsx.mjs");
      const buf = await file.arrayBuffer();
      const wb = SheetJS.read(buf, { type: "array", cellDates: true });

      // Parse "Rates" sheet — has individual hotel prices
      const ratesSheet = wb.Sheets["Rates"];
      const overviewSheet = wb.Sheets["Overview"];

      if (!ratesSheet || !overviewSheet) throw new Error("Beklenen sayfalar bulunamadı (Rates, Overview)");

      const rates = SheetJS.utils.sheet_to_json(ratesSheet, { header: 1, defval: null });
      const overview = SheetJS.utils.sheet_to_json(overviewSheet, { header: 1, defval: null });

      // Find header row in Rates (row with "Day", "Date")
      let headerIdx = rates.findIndex(r => r.some(c => c === "Day"));
      if (headerIdx < 0) throw new Error("Rates sayfasında başlık satırı bulunamadı");
      const headers = rates[headerIdx];

      // Today
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      // Find today's row
      const todayRow = rates.slice(headerIdx + 1).find(row => {
        const d = row[headers.indexOf("Date")];
        if (!d) return false;
        const rd = new Date(d); rd.setHours(0, 0, 0, 0);
        return rd.getTime() === today.getTime();
      });

      if (!todayRow) throw new Error("Bugünün verisi Excel'de bulunamadı");

      // Extract hotel prices (all columns after "Market demand")
      const hotelCols = [];
      const knownNonHotels = ["Day","Date","Market demand","Centro Westside by Rotana"];
      headers.forEach((h, i) => {
        if (h && !knownNonHotels.includes(h)) {
          const price = todayRow[i];
          if (price && typeof price === "number") {
            hotelCols.push({ name: h, price: Math.round(price * 100) / 100 });
          }
        }
      });

      // Get median compset from Overview
      const ovHeaders = overview.find(r => r.some(c => c === "Day"));
      const ovHIdx = overview.findIndex(r => r.some(c => c === "Day"));
      const ovTodayRow = overview.slice(ovHIdx + 1).find(row => {
        const d = row[ovHeaders.indexOf("Date")];
        if (!d) return false;
        const rd = new Date(d); rd.setHours(0, 0, 0, 0);
        return rd.getTime() === today.getTime();
      });

      const medianCompset = ovTodayRow ? ovTodayRow[ovHeaders.indexOf("Median lowest compset")] : null;
      const marketDemand = ovTodayRow ? ovTodayRow[ovHeaders.indexOf("Market demand")] : null;
      const holidays = ovTodayRow ? ovTodayRow[ovHeaders.indexOf("Holidays")] : null;
      const events = ovTodayRow ? ovTodayRow[ovHeaders.indexOf("Events")] : null;

      const demandPct = marketDemand ? Math.round(marketDemand * 100) : null;
      const demandLabel = demandPct !== null ? (demandPct > 70 ? "🔴 Yüksek" : demandPct > 40 ? "🟡 Orta" : "🟢 Düşük") : null;

      setExcelData({ hotels: hotelCols, medianCompset, demandPct, demandLabel, holidays, events, updatedAt: new Date().toLocaleTimeString("tr-TR") });

      // Auto-fill compset and demand
      if (medianCompset) setVars(v => ({
        ...v,
        compsetADR: medianCompset.toString(),
        compsetDetails: hotelCols,
        todayDemand: demandPct?.toString() || "",
        demandNotes: [
          demandLabel ? `Piyasa talebi: ${demandLabel} (%${demandPct})` : "",
          holidays ? `Tatil: ${holidays}` : "",
          events ? `Etkinlik: ${events}` : ""
        ].filter(Boolean).join(" · ") || v.demandNotes
      }));

    } catch (e) {
      setError("Excel okunamadı: " + e.message);
    } finally { setXlsxLoading(false); }
  }, []);

  const handleFile = useCallback((file) => {
    if (!file) return;
    if (!file.name.match(/\.(xlsx|xls)$/i)) { setError("Lütfen .xlsx dosyası yükleyin"); return; }
    parseExcel(file);
  }, [parseExcel]);

  // Analyze
  const handleAnalyze = async () => {
    if (!constants.totalRooms || !constants.monthlyBudget || !vars.realizedRevenue || !vars.remainingDays || !vars.compsetADR) {
      setError("Zorunlu alanları doldurun (Ciro, Kalan Gün, Compset ADR)"); return;
    }
    setError(null); setLoading(true); setResult(null);

    const hotelDetail = vars.compsetDetails.length > 0
      ? "\nRAKİP FİYATLAR (EUR, Booking.com):\n" + vars.compsetDetails.map(h => `- ${h.name}: €${h.price}`).join("\n")
      : "";

    const msg = `AYLIK SABİTLER:
- Oda: ${constants.totalRooms} | Ay: ${monthDays} gün | Hedef Doluluk: %${constants.sellThrough}
- Hedef Havuz: ${totalMonthPool} | Komisyon: %${constants.commission} | KDV: %${constants.vat}
- Bütçe: €${Number(constants.monthlyBudget).toLocaleString("de-DE")}
- EUR/TRY Kuru: ${activeRate || "bilinmiyor"}

GÜNLÜK VERİLER:
- Gerçekleşen Ciro: €${Number(vars.realizedRevenue).toLocaleString("de-DE")}
- Kümülatif Satılan Oda: ${vars.soldRooms || "girilmedi"}
- Kalan Satılabilir Havuz: ${roomPool}${occupancyPct !== null ? ` (%${occupancyPct} tamamlandı)` : ""}
- Kalan Gün: ${vars.remainingDays}
- Median Compset ADR: €${vars.compsetADR}${hotelDetail}
- Piyasa Talebi: ${vars.todayDemand ? `%${vars.todayDemand}` : "bilinmiyor"}
- Notlar: ${vars.demandNotes || "yok"}

HESAP:
- Kalan Bütçe: €${remBudget.toFixed(2)}
- Net ADR: €${netADR.toFixed(2)}
- Acenta Brüt ADR: €${grossADR_agency.toFixed(2)}
- Direkt Brüt ADR: €${grossADR_direct.toFixed(2)}
- Durum: ${situation === "A" ? "A — Acenta brüt > Compset, bütçe gerisinde" : situation === "B" ? "B — Acenta brüt < Compset, avantajlı" : "?"}`;

    try {
      const resp = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ model: "claude-sonnet-4-20250514", max_tokens: 1000, system: SYSTEM_PROMPT, messages: [{ role: "user", content: msg }] })
      });
      const data = await resp.json();
      setResult(data.content?.map(b => b.text || "").join("\n") || "Yanıt alınamadı.");
    } catch (e) { setError("API hatası: " + e.message); } finally { setLoading(false); }
  };

  // PDF Export
  const handlePDFExport = useCallback(() => {
    const today = new Date().toLocaleDateString("tr-TR", { day: "2-digit", month: "long", year: "numeric" });
    const hotelRows = vars.compsetDetails.length > 0
      ? vars.compsetDetails.map(h => `<tr><td>${h.name}</td><td style="text-align:right;font-weight:600;">€${h.price}</td></tr>`).join("")
      : "";
    const resultHtml = result
      ? result.split("\n").map(line => {
          if (!line.trim()) return "<br/>";
          const c = line.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
          if (["📊","🎯","🧠","⚡"].some(e => line.startsWith(e))) return `<p style="margin:12px 0 6px;font-size:15px;">${c}</p>`;
          return `<p style="margin:4px 0 4px 20px;font-size:14px;color:#444;">${c}</p>`;
        }).join("") : "<p>Analiz yapılmadı.</p>";

    const html = `<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"/><title>Revenue Raporu — ${today}</title>
    <style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:Georgia,serif;color:#1a1a1a;padding:40px;max-width:820px;margin:0 auto;}.hdr{border-bottom:3px solid #c9a84c;padding-bottom:16px;margin-bottom:24px;display:flex;justify-content:space-between;align-items:flex-end;}.hdr h1{font-size:20px;font-weight:700;}.hdr h2{font-size:12px;color:#888;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:4px;}.hdr-r{text-align:right;font-size:12px;color:#888;}.date{font-size:14px;font-weight:700;color:#c9a84c;}.sec{margin-bottom:20px;}.sec-t{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#c9a84c;font-weight:700;margin-bottom:10px;border-bottom:1px solid #f0e8d0;padding-bottom:4px;}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px;}.m{background:#faf8f3;border:1px solid #e8dcc8;border-radius:8px;padding:10px;text-align:center;}.ml{font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;}.mv{font-size:16px;font-weight:700;}.gold{color:#c9a84c;}.green{color:#2d8a4e;}.red{color:#c0392b;}table{width:100%;border-collapse:collapse;font-size:13px;}th{background:#faf8f3;padding:7px 10px;text-align:left;font-size:11px;text-transform:uppercase;color:#888;border-bottom:2px solid #e8dcc8;}td{padding:7px 10px;border-bottom:1px solid #f0ece4;}.rb{background:#fffdf7;border:1px solid #e8dcc8;border-left:4px solid #c9a84c;border-radius:8px;padding:18px;}.ftr{margin-top:32px;padding-top:12px;border-top:1px solid #e8dcc8;font-size:11px;color:#bbb;display:flex;justify-content:space-between;}@media print{@page{margin:15mm;}}</style>
    </head><body>
    <div class="hdr"><div><h2>İstanbul Basın Ekspres · Revenue Management</h2><h1>Günlük Fiyat Analiz Raporu</h1></div><div class="hdr-r"><div class="date">${today}</div><div>Kalan: ${vars.remainingDays} gün | Kur: 1€=₺${activeRate||"?"}</div></div></div>
    <div class="sec"><div class="sec-t">Finansal Özet</div>
    <div class="metrics">
      <div class="m"><div class="ml">Aylık Bütçe</div><div class="mv">€${Number(constants.monthlyBudget).toLocaleString("de-DE")}</div></div>
      <div class="m"><div class="ml">Gerçekleşen</div><div class="mv">€${Number(vars.realizedRevenue).toLocaleString("de-DE")}</div></div>
      <div class="m"><div class="ml">Kalan Bütçe</div><div class="mv red">€${remBudget.toFixed(0)}</div></div>
      <div class="m"><div class="ml">Kalan Havuz</div><div class="mv">${roomPool.toLocaleString()}</div></div>
    </div>
    <div class="metrics">
      <div class="m"><div class="ml">Net ADR</div><div class="mv">€${netADR.toFixed(2)}</div></div>
      <div class="m"><div class="ml">Acenta Brüt</div><div class="mv gold">€${grossADR_agency.toFixed(2)}</div></div>
      <div class="m"><div class="ml">Direkt Brüt</div><div class="mv green">€${grossADR_direct.toFixed(2)}</div></div>
      <div class="m"><div class="ml">Compset ADR</div><div class="mv">€${Number(vars.compsetADR).toFixed(2)}</div></div>
    </div></div>
    ${hotelRows ? `<div class="sec"><div class="sec-t">Rakip Fiyatları (Booking.com · EUR)</div><table><thead><tr><th>Otel</th><th style="text-align:right;">Fiyat</th></tr></thead><tbody>${hotelRows}<tr style="background:#faf8f3;font-weight:700;"><td>MEDIAN COMPSET ADR</td><td style="text-align:right;color:#c9a84c;">€${Number(vars.compsetADR).toFixed(2)}</td></tr></tbody></table></div>` : ""}
    <div class="sec"><div class="sec-t">AI Analiz Sonucu</div><div class="rb">${resultHtml}</div></div>
    ${vars.demandNotes ? `<div class="sec"><div class="sec-t">Piyasa Notları</div><p style="font-size:14px;color:#555;font-style:italic;">${vars.demandNotes}</p></div>` : ""}
    <div class="ftr"><span>Powered by Claude · Revenue Intelligence · The G Hotels İstanbul</span><span>${today}</span></div>
    </body></html>`;

    const blob = new Blob([html], { type: "text/html;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `revenue-raporu-${today.replace(/\s/g,"-")}.html`;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  }, [vars, constants, result, remBudget, netADR, grossADR_agency, grossADR_direct, roomPool, activeRate]);

  const fmt = (text) => text.split("\n").map((line, i) => {
    if (["📊","🎯","🧠","⚡"].some(e => line.startsWith(e))) {
      const parts = line.split("**");
      return <p key={i} style={{marginBottom:"14px"}}>{parts.map((p,j) => j%2===1 ? <strong key={j} style={{color:"#c9a84c"}}>{p}</strong> : p)}</p>;
    }
    return line ? <p key={i} style={{marginBottom:"4px",marginLeft:"16px",fontSize:"14px",opacity:0.9}}>{line}</p> : <br key={i}/>;
  });

  const inp = { background:"rgba(255,255,255,0.05)", border:"1px solid rgba(201,168,76,0.3)", borderRadius:"8px", color:"#e8dcc8", padding:"10px 14px", width:"100%", fontSize:"14px", outline:"none", boxSizing:"border-box" };
  const lbl = { display:"block", fontSize:"11px", letterSpacing:"0.08em", textTransform:"uppercase", color:"#c9a84c", marginBottom:"6px", fontWeight:"600" };

  return (
    <div style={{minHeight:"100vh", background:"#0d0d0d", fontFamily:"'Georgia', serif", color:"#e8dcc8"}}>
      <div style={{maxWidth:"900px", margin:"0 auto", padding:"40px 24px"}}>

        {/* Header */}
        <div style={{textAlign:"center", marginBottom:"40px"}}>
          <div style={{fontSize:"11px", letterSpacing:"0.25em", color:"#c9a84c", marginBottom:"10px", textTransform:"uppercase"}}>The G Hotels İstanbul · Gelir Yönetimi</div>
          <h1 style={{fontSize:"clamp(24px,5vw,38px)", fontWeight:"400", margin:"0 0 6px", lineHeight:1.1}}>Revenue Management</h1>
          <h1 style={{fontSize:"clamp(24px,5vw,38px)", fontWeight:"700", margin:"0 0 14px", color:"#c9a84c", lineHeight:1.1}}>Yapay Zeka Asistanı</h1>
          <p style={{color:"#7a7265", fontSize:"13px", maxWidth:"500px", margin:"0 auto", lineHeight:1.6}}>
            OTA Insight Excel'ini yükle → Compset otomatik dolsun → Analizi al
          </p>
        </div>

        {/* EUR/TRY Rate */}
        <div style={{background:"rgba(201,168,76,0.07)", border:"1px solid rgba(201,168,76,0.3)", borderRadius:"14px", padding:"16px 24px", marginBottom:"20px", display:"flex", alignItems:"center", justifyContent:"space-between", flexWrap:"wrap", gap:"12px"}}>
          <div>
            <div style={{fontSize:"11px", letterSpacing:"0.12em", textTransform:"uppercase", color:"#c9a84c", marginBottom:"4px"}}>💱 EUR / TRY Kuru</div>
            {exchangeRate
              ? <div style={{fontSize:"20px", fontWeight:"700"}}>1 € = <span style={{color:"#c9a84c"}}>₺{exchangeRate}</span> <span style={{fontSize:"11px", color:"#7a7265"}}>· Anlık</span></div>
              : <div style={{fontSize:"13px", color:"#7a7265"}}>{rateLoading ? "Çekiliyor..." : "Alınamadı"}</div>}
          </div>
          <div style={{display:"flex", gap:"10px", alignItems:"center"}}>
            <input type="number" placeholder="Manuel kur" value={rateManual} onChange={e => setRateManual(e.target.value)} style={{...inp, width:"120px", padding:"8px 12px"}}/>
            <button onClick={fetchRate} disabled={rateLoading} style={{padding:"8px 14px", fontSize:"12px", background:"rgba(201,168,76,0.15)", color:"#c9a84c", border:"1px solid rgba(201,168,76,0.3)", borderRadius:"8px", cursor:"pointer"}}>
              {rateLoading ? "⏳" : "🔄"}
            </button>
            <button onClick={handleNewMonth} style={{padding:"8px 14px", fontSize:"12px", fontWeight:"700", background:"rgba(82,192,130,0.15)", color:"#52c082", border:"1px solid rgba(82,192,130,0.3)", borderRadius:"8px", cursor:"pointer", whiteSpace:"nowrap"}}>
              📅 Yeni Ay Başlat
            </button>
          </div>
        </div>

        {/* Constants */}
        <div style={{background:"rgba(201,168,76,0.05)", border:"1px solid rgba(201,168,76,0.2)", borderRadius:"16px", padding:"28px", marginBottom:"20px"}}>
          <div style={{display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:"20px"}}>
            <h2 style={{fontSize:"13px", letterSpacing:"0.15em", textTransform:"uppercase", color:"#c9a84c", margin:0}}>📋 Aylık Sabitler</h2>
            {locked && <button onClick={() => setLocked(false)} style={{fontSize:"11px", color:"#7a7265", background:"none", border:"1px solid rgba(122,114,101,0.3)", borderRadius:"6px", padding:"4px 10px", cursor:"pointer"}}>Düzenle</button>}
          </div>
          <div style={{display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:"16px", marginBottom:"16px"}}>
            <div><label style={lbl}>Toplam Oda</label><input type="number" placeholder="264" value={constants.totalRooms} disabled={locked} onChange={e => setConstants({...constants,totalRooms:e.target.value})} style={{...inp,opacity:locked?0.5:1}}/></div>
            <div><label style={lbl}>Ay Gün Sayısı</label><input type="number" placeholder="31" value={constants.monthDays} disabled={locked} onChange={e => setConstants({...constants,monthDays:e.target.value})} style={{...inp,opacity:locked?0.5:1}}/></div>
            <div><label style={lbl}>Hedef Doluluk %</label>
              <div style={{position:"relative"}}>
                <input type="number" min="1" max="100" value={constants.sellThrough} disabled={locked} onChange={e => setConstants({...constants,sellThrough:e.target.value})} style={{...inp,opacity:locked?0.5:1,paddingRight:"28px"}}/>
                <span style={{position:"absolute",right:"12px",top:"50%",transform:"translateY(-50%)",color:"#c9a84c",fontSize:"13px",pointerEvents:"none"}}>%</span>
              </div>
            </div>
            <div><label style={lbl}>Acenta Komisyonu %</label>
              <div style={{position:"relative"}}>
                <input type="number" value={constants.commission} disabled={locked} onChange={e => setConstants({...constants,commission:e.target.value})} style={{...inp,opacity:locked?0.5:1,paddingRight:"28px"}}/>
                <span style={{position:"absolute",right:"12px",top:"50%",transform:"translateY(-50%)",color:"#c9a84c",fontSize:"13px",pointerEvents:"none"}}>%</span>
              </div>
            </div>
            <div><label style={lbl}>KDV %</label>
              <div style={{position:"relative"}}>
                <input type="number" value={constants.vat} disabled={locked} onChange={e => setConstants({...constants,vat:e.target.value})} style={{...inp,opacity:locked?0.5:1,paddingRight:"28px"}}/>
                <span style={{position:"absolute",right:"12px",top:"50%",transform:"translateY(-50%)",color:"#c9a84c",fontSize:"13px",pointerEvents:"none"}}>%</span>
              </div>
            </div>
            <div><label style={lbl}>Aylık Bütçe (€)</label><input type="number" placeholder="örn: 150000" value={constants.monthlyBudget} disabled={locked} onChange={e => setConstants({...constants,monthlyBudget:e.target.value})} style={{...inp,opacity:locked?0.5:1}}/></div>
          </div>
          {!locked && constants.totalRooms && constants.monthlyBudget && (
            <button onClick={() => setLocked(true)} style={{fontSize:"12px", color:"#c9a84c", background:"rgba(201,168,76,0.1)", border:"1px solid rgba(201,168,76,0.3)", borderRadius:"8px", padding:"8px 16px", cursor:"pointer"}}>✓ Kilitle</button>
          )}
        </div>

        {/* Daily Variables */}
        <div style={{background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.08)", borderRadius:"16px", padding:"28px", marginBottom:"20px"}}>
          <h2 style={{fontSize:"13px", letterSpacing:"0.15em", textTransform:"uppercase", color:"#e8dcc8", marginBottom:"20px"}}>📅 Günlük Değişkenler</h2>

          <div style={{display:"grid", gridTemplateColumns:"1fr 1fr 1fr", gap:"16px", marginBottom:"16px"}}>
            <div><label style={lbl}>Gerçekleşen Ciro (€)</label><input type="number" placeholder="örn: 72000" value={vars.realizedRevenue} onChange={e => setVars({...vars,realizedRevenue:e.target.value})} style={inp}/></div>
            <div><label style={lbl}>Kümülatif Satılan Oda</label><input type="number" placeholder="örn: 1091" value={vars.soldRooms} onChange={e => setVars({...vars,soldRooms:e.target.value})} style={inp}/></div>
            <div><label style={lbl}>Kalan Gün Sayısı</label><input type="number" placeholder="örn: 15" value={vars.remainingDays} onChange={e => setVars({...vars,remainingDays:e.target.value})} style={inp}/></div>
          </div>

          {/* Pool info */}
          {totalRooms > 0 && (
            <div style={{background:"rgba(201,168,76,0.08)", border:"1px solid rgba(201,168,76,0.2)", borderRadius:"8px", padding:"12px 16px", marginBottom:"16px", fontSize:"13px", color:"#c9a84c"}}>
              🏨 <strong>{totalRooms} × {monthDays} × %{constants.sellThrough} = {totalMonthPool.toLocaleString()} hedef</strong>
              {vars.soldRooms !== "" && <> − <strong>{soldRooms.toLocaleString()} satılan</strong> = <strong style={{color:"#e8dcc8"}}>{roomPool.toLocaleString()} satılabilir</strong>{occupancyPct !== null && <span style={{color:"#7a7265"}}> (%{occupancyPct} tamamlandı)</span>}</>}
            </div>
          )}

          {/* OTA Insight Excel Upload */}
          <div style={{marginBottom:"16px"}}>
            <label style={lbl}>📊 OTA Insight Excel — Compset Otomatik Yükle</label>
            <div
              onDrop={e => { e.preventDefault(); setDragOver(false); handleFile(e.dataTransfer.files[0]); }}
              onDragOver={e => { e.preventDefault(); setDragOver(true); }}
              onDragLeave={() => setDragOver(false)}
              onClick={() => fileRef.current?.click()}
              style={{border:`2px dashed ${dragOver?"#c9a84c":excelData?"rgba(82,192,130,0.5)":"rgba(201,168,76,0.25)"}`, borderRadius:"12px", padding:"20px", textAlign:"center", cursor:"pointer", background:dragOver?"rgba(201,168,76,0.08)":excelData?"rgba(82,192,130,0.04)":"rgba(255,255,255,0.02)", transition:"all 0.2s"}}>
              <input ref={fileRef} type="file" accept=".xlsx,.xls" onChange={e => handleFile(e.target.files[0])} style={{display:"none"}}/>
              {xlsxLoading ? (
                <div style={{color:"#c9a84c", fontSize:"14px"}}>⏳ Excel okunuyor...</div>
              ) : excelData ? (
                <div>
                  <div style={{fontSize:"13px", color:"#52c082", fontWeight:"700", marginBottom:"6px"}}>✓ OTA Insight verisi yüklendi · {excelData.updatedAt}</div>
                  <div style={{display:"flex", justifyContent:"center", gap:"20px", flexWrap:"wrap"}}>
                    <span style={{fontSize:"12px", color:"#c9a84c"}}>Median Compset: <strong>€{excelData.medianCompset?.toFixed(2)}</strong></span>
                    {excelData.demandLabel && <span style={{fontSize:"12px", color:"#9a9285"}}>Talep: <strong>{excelData.demandLabel}</strong></span>}
                    {excelData.holidays && <span style={{fontSize:"12px", color:"#e05252"}}>🗓 {excelData.holidays}</span>}
                    {excelData.events && <span style={{fontSize:"12px", color:"#e0a052"}}>⭐ {excelData.events}</span>}
                  </div>
                  <div style={{fontSize:"10px", color:"#4a4540", marginTop:"6px"}}>Güncellemek için tıkla</div>
                </div>
              ) : (
                <div>
                  <div style={{fontSize:"24px", marginBottom:"8px"}}>📂</div>
                  <div style={{fontSize:"13px", color:"#c9a84c", marginBottom:"4px"}}>OTA Insight Excel dosyasını sürükle veya tıkla</div>
                  <div style={{fontSize:"11px", color:"#5a5248"}}>.xlsx · Rates + Overview sayfaları gerekli</div>
                </div>
              )}
            </div>
          </div>

          {/* Compset detail table */}
          {vars.compsetDetails.length > 0 && (
            <div style={{background:"rgba(82,192,130,0.04)", border:"1px solid rgba(82,192,130,0.12)", borderRadius:"10px", padding:"14px", marginBottom:"16px"}}>
              <div style={{fontSize:"11px", color:"#52c082", letterSpacing:"0.1em", textTransform:"uppercase", marginBottom:"10px"}}>📊 Rakip Fiyatları — Booking.com · EUR</div>
              <div style={{display:"grid", gridTemplateColumns:"1fr 1fr", gap:"6px"}}>
                {vars.compsetDetails.map((h,i) => (
                  <div key={i} style={{background:"rgba(255,255,255,0.03)", borderRadius:"8px", padding:"8px 12px", display:"flex", justifyContent:"space-between", alignItems:"center"}}>
                    <span style={{fontSize:"11px", color:"#9a9285"}}>{h.name}</span>
                    <span style={{fontSize:"13px", fontWeight:"700"}}>€{h.price}</span>
                  </div>
                ))}
                <div style={{background:"rgba(201,168,76,0.1)", borderRadius:"8px", padding:"8px 12px", display:"flex", justifyContent:"space-between", alignItems:"center", border:"1px solid rgba(201,168,76,0.2)", gridColumn:"1/-1"}}>
                  <span style={{fontSize:"12px", color:"#c9a84c", fontWeight:"700"}}>MEDIAN COMPSET ADR</span>
                  <span style={{fontSize:"15px", fontWeight:"700", color:"#c9a84c"}}>€{Number(vars.compsetADR).toFixed(2)}</span>
                </div>
              </div>
            </div>
          )}

          {/* Manual compset override */}
          <div style={{display:"flex", gap:"10px", alignItems:"center", marginBottom:"16px"}}>
            <span style={{fontSize:"11px", color:"#5a5248", whiteSpace:"nowrap"}}>Compset ADR manuel (€):</span>
            <input type="number" placeholder="Excel yoksa gir" value={vars.compsetADR} onChange={e => setVars({...vars,compsetADR:e.target.value,compsetDetails:[]})} style={{...inp,fontSize:"13px",padding:"8px 12px"}}/>
          </div>

          <div><label style={lbl}>Talep Durumu / Notlar</label>
            <input type="text" placeholder="Otomatik dolar, istersen düzenle" value={vars.demandNotes} onChange={e => setVars({...vars,demandNotes:e.target.value})} style={inp}/>
          </div>
        </div>

        {/* Metrics */}
        {vars.realizedRevenue && vars.remainingDays && (
          <div style={{marginBottom:"20px"}}>
            <div style={{display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:"12px", marginBottom:"8px"}}>
              {[
                {label:"Satılabilir Havuz", value:roomPool.toLocaleString()},
                {label:"Kalan Bütçe", value:`€${remBudget.toFixed(0)}`},
                {label:"Net ADR", value:`€${netADR.toFixed(2)}`},
              ].map((m,i) => (
                <div key={i} style={{background:"rgba(255,255,255,0.03)", border:"1px solid rgba(255,255,255,0.06)", borderRadius:"12px", padding:"14px", textAlign:"center"}}>
                  <div style={{fontSize:"10px", color:"#7a7265", letterSpacing:"0.1em", textTransform:"uppercase", marginBottom:"8px"}}>{m.label}</div>
                  <div style={{fontSize:"16px", fontWeight:"700", color:"#e8dcc8"}}>{m.value}</div>
                </div>
              ))}
            </div>
            <div style={{display:"grid", gridTemplateColumns:"1fr 1fr", gap:"12px"}}>
              <div style={{background:"rgba(201,168,76,0.07)", border:"1px solid rgba(201,168,76,0.4)", borderRadius:"12px", padding:"16px", textAlign:"center"}}>
                <div style={{fontSize:"10px", color:"#c9a84c", letterSpacing:"0.1em", textTransform:"uppercase", marginBottom:"6px"}}>Acenta Brüt (+%{constants.commission} kom. +%{constants.vat} KDV)</div>
                <div style={{fontSize:"22px", fontWeight:"700", color:"#c9a84c"}}>€{grossADR_agency.toFixed(2)}</div>
                <div style={{fontSize:"11px", color:"#7a7265", marginTop:"4px"}}>₺{activeRate ? Math.round(grossADR_agency * activeRate).toLocaleString("tr-TR") : "—"}</div>
              </div>
              <div style={{background:"rgba(82,192,130,0.06)", border:"1px solid rgba(82,192,130,0.3)", borderRadius:"12px", padding:"16px", textAlign:"center"}}>
                <div style={{fontSize:"10px", color:"#52c082", letterSpacing:"0.1em", textTransform:"uppercase", marginBottom:"6px"}}>Direkt Brüt (+%{constants.vat} KDV)</div>
                <div style={{fontSize:"22px", fontWeight:"700", color:"#52c082"}}>€{grossADR_direct.toFixed(2)}</div>
                <div style={{fontSize:"11px", color:"#7a7265", marginTop:"4px"}}>₺{activeRate ? Math.round(grossADR_direct * activeRate).toLocaleString("tr-TR") : "—"}</div>
              </div>
            </div>
            <div style={{marginTop:"8px", background:situation==="A"?"rgba(224,82,82,0.08)":"rgba(82,192,130,0.08)", border:`1px solid ${situation==="A"?"rgba(224,82,82,0.3)":"rgba(82,192,130,0.3)"}`, borderRadius:"10px", padding:"10px 16px", textAlign:"center", fontSize:"13px", color:situation==="A"?"#e05252":"#52c082", fontWeight:"700"}}>
              {situation==="A" ? "⚠️ Acenta brüt fiyatı compset üstünde — değer artırıcı strateji önerilir" : situation==="B" ? "✅ Acenta brüt fiyatı compset altında — fiyat artırım fırsatı var" : "—"}
            </div>
          </div>
        )}

        <button onClick={handleAnalyze} disabled={loading} style={{width:"100%", padding:"18px", fontSize:"14px", letterSpacing:"0.12em", textTransform:"uppercase", background:loading?"rgba(201,168,76,0.2)":"linear-gradient(135deg,#c9a84c,#a07830)", color:"#0d0d0d", border:"none", borderRadius:"12px", cursor:loading?"not-allowed":"pointer", fontWeight:"700", marginBottom:"24px"}}>
          {loading ? "⏳ Analiz Ediliyor..." : "🔍 Günü Analiz Et"}
        </button>

        {error && <div style={{background:"rgba(224,82,82,0.1)", border:"1px solid rgba(224,82,82,0.3)", borderRadius:"12px", padding:"16px", marginBottom:"20px", color:"#e05252", fontSize:"14px"}}>{error}</div>}

        {result && (
          <div style={{background:"rgba(201,168,76,0.04)", border:"1px solid rgba(201,168,76,0.25)", borderRadius:"16px", padding:"28px"}}>
            <div style={{display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:"20px"}}>
              <h3 style={{fontSize:"11px", letterSpacing:"0.2em", textTransform:"uppercase", color:"#c9a84c", margin:0}}>AI Analiz Sonucu</h3>
              <button onClick={handlePDFExport} style={{padding:"8px 16px", fontSize:"12px", fontWeight:"700", background:"linear-gradient(135deg,#c9a84c,#a07830)", color:"#0d0d0d", border:"none", borderRadius:"8px", cursor:"pointer"}}>
                📄 Rapor İndir
              </button>
            </div>
            <div style={{lineHeight:"1.8", fontSize:"15px"}}>{fmt(result)}</div>
          </div>
        )}

        <p style={{textAlign:"center", fontSize:"11px", color:"#3a3530", marginTop:"40px", letterSpacing:"0.08em"}}>
          POWERED BY CLAUDE · REVENUE INTELLIGENCE · THE G HOTELS İSTANBUL
        </p>
      </div>
    </div>
  );
}
